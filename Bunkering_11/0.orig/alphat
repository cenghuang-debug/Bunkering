FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];
internalField   uniform 3.3268e-01; // background, from k/epsilon above (turbulence_initial_conditions_case11.py)

boundaryField
{
    right               { type calculated; value $internalField; }
    left                { type calculated; value $internalField; }
    front               { type calculated; value $internalField; }
    back                { type calculated; value $internalField; }
    top                 { type calculated; value $internalField; }
    bottom              { type compressible::alphatWallFunction; Prt 0.85; value $internalField; }
    bunkering-boat_m    { type compressible::alphatWallFunction; Prt 0.85; value $internalField; }
    bunkering-quay_larger_m    { type compressible::alphatWallFunction; Prt 0.85; value $internalField; }
    nozzle_holder_wall  { type compressible::alphatWallFunction; Prt 0.85; value $internalField; }
    nozzle              { type calculated; value uniform 8.7584e-03; }
}
